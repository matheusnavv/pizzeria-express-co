# ========================================================
# Pizzería Express — Colombia — Environment Configuration
# ========================================================

# Application URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# PostgreSQL Database Connection
# Example: postgresql://postgres:password@localhost:5432/pizzeria_co?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/pizzeria_co?schema=public"

# XPAG Payments Gateway (Colombia COP: Nequi & Bre-B)
# Documentation: https://xpag.global/docs/
# Sandbox credentials:
# XPAG_CLIENT_ID="xpagsandbox_00000000"
# XPAG_CLIENT_SECRET="202620262026202620262026"
XPAG_CLIENT_ID=""
XPAG_CLIENT_SECRET=""
XPAG_WEBHOOK_SECRET=""
XPAG_BASE_URL="https://api.xpag.global"

# Meta Pixel (Facebook & Instagram Ads)
# Leave blank if not configured; application runs smoothly without errors
NEXT_PUBLIC_META_PIXEL_ID=""

# Operational Environment
NODE_ENV="development"
